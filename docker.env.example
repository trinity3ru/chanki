# Пример файла с переменными окружения для Docker
# Скопируйте этот файл как .env и заполните реальными значениями

# ===========================================
# ОБЯЗАТЕЛЬНЫЕ НАСТРОЙКИ
# ===========================================

# Токен Telegram бота (получите у @BotFather)
TELEGRAM_BOT_TOKEN=ваш_токен_бота_здесь

# ===========================================
# ПРОКСИ ДЛЯ TELEGRAM
# ===========================================

# Заполняйте, только если api.telegram.org недоступен с сервера напрямую.
# Проверить: curl -sS --max-time 15 https://api.telegram.org
# Форматы: http://login:password@host:port  или  socks5://login:password@host:port
# Продавцы прокси часто выдают строку вида ip:port:login:password - её нужно
# переписать в URL: 1.2.3.4:8000:user:pass  ->  http://user:pass@1.2.3.4:8000
# Если в пароле есть : @ / ? # - закодируйте их (@ = %40, : = %3A).
# На проверки сайтов не влияет - они всегда идут напрямую с сервера.
# TELEGRAM_PROXY_URL=

# Таймауты соединения с Telegram (секунды)
CONNECT_TIMEOUT=20
READ_TIMEOUT=20

# ===========================================
# ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ (опционально)
# ===========================================

# Интервал проверки сайтов (в часах)
CHECK_INTERVAL_HOURS=6

# Таймаут HTTP запросов (в секундах)
REQUEST_TIMEOUT=10

# Минимальная длина контента (в символах)
MIN_CONTENT_LENGTH=100

# Настройки детекции изменений
SIGNIFICANT_CHANGE_THRESHOLD=0.15
MIN_CHANGED_CHARS=50
MAX_LENGTH_CHANGE_RATIO=0.30

# Задержка первой проверки после старта (в секундах)
FIRST_CHECK_DELAY_SECONDS=60

# ===========================================
# ПУТИ К ДАННЫМ
# ===========================================

# В docker-compose.yml эти пути уже заданы и указывают в volume'ы контейнера.
# Здесь их переопределять не нужно - строки оставлены для локального запуска
# без Docker.
# SITES_DATABASE_FILE=data/sites.json
# SNAPSHOTS_DIR=data/snapshots
# LOG_FILE=logs/monitor.log

# ===========================================
# ИНСТРУКЦИЯ ПО СОЗДАНИЮ .env ФАЙЛА
# ===========================================

# 1. Скопируйте этот файл:
#    cp docker.env.example .env
#
# 2. Отредактируйте .env и замените токен:
#    nano .env
#
# 3. Ограничьте доступ к файлу:
#    chmod 600 .env
#
# 4. Убедитесь что .env не попадет в git:
#    git status (файл .env не должен отображаться)
#
# 5. Запустите приложение:
#    ./deploy.sh
